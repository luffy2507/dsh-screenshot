{
  "name": "dsh-screenshot",
  "version": "0.1.0",
  "description": "Manual screenshot button for the DeepSeek Harness composer: capture a screen region and send it to the model as an image attachment (Windows only).",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "screenshot.ps1",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "screenshot",
    "snipping-tool",
    "image-capture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luffy2507/dsh-screenshot.git"
  },
  "homepage": "https://github.com/luffy2507/dsh-screenshot#readme",
  "author": "luffy2507",
  "license": "MIT",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
